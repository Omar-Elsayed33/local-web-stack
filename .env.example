PROJECT_NAME=local-web-stack

EXTERNAL_PROXY_NETWORK=proxy

NGINX_CONTAINER_NAME=local-web-nginx
PHP_CONTAINER_NAME=local-web-php
MYSQL_CONTAINER_NAME=local-web-mysql
PHPMYADMIN_CONTAINER_NAME=local-web-phpmyadmin
MAILPIT_CONTAINER_NAME=local-web-mailpit

DOMAIN_SUFFIX=.test
PHPMYADMIN_DOMAIN=pma.test
MAILPIT_DOMAIN=mail.test

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_PORT=3307

# Optional direct ports
NGINX_PORT=8080
PHPMYADMIN_PORT=8081
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
