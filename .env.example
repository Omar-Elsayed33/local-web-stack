PROJECT_NAME=local-web-stack

EXTERNAL_PROXY_NETWORK=proxy

NGINX_CONTAINER_NAME=local-web-nginx
PHP_CONTAINER_NAME=local-web-php
MYSQL_CONTAINER_NAME=local-web-mysql
PHPMYADMIN_CONTAINER_NAME=local-web-phpmyadmin
MAILPIT_CONTAINER_NAME=local-web-mailpit

DOMAIN_SUFFIX=.local
PHPMYADMIN_DOMAIN=pma.local
MAILPIT_DOMAIN=mail.local

# --- MySQL credentials (used by PHP scripts, phpMyAdmin and desktop tools) ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app

# Hostname PHP uses to reach MySQL INSIDE Docker (the compose service name).
MYSQL_HOST=mysql

# Port on your HOST machine for external clients (DBeaver, etc.).
# The internal port between containers is always 3306.
MYSQL_PORT=3307

# Optional direct ports
NGINX_PORT=8080
PHPMYADMIN_PORT=8081
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
